# Basket environment configuration example.
# Copy to .env and adjust as needed.

# MongoDB connection URL (non-obvious port 47017).
MONGO_URL=mongodb://mongo:47017

# MongoDB database name.
MONGO_DB=basket

# FastAPI backend port (non-obvious port 18420).
API_PORT=18420

# Frontend API base URL used by Vite (non-obvious frontend port 8173).
VITE_API_BASE=http://localhost:18420
